<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>404 - Not Found</title>
    <!-- Security Meta Tags -->
    <meta http-equiv="Content-Security-Policy" content="default-src 'self'; img-src 'self' data: https:; script-src 'self' https://cdnjs.cloudflare.com; style-src 'self' 'unsafe-inline' https://cdnjs.cloudflare.com;">
    <meta http-equiv="X-Frame-Options" content="DENY">
    <meta http-equiv="X-Content-Type-Options" content="nosniff">
    <meta name="referrer" content="no-referrer">
    <!-- Tailwind CSS -->
    <link href="https://cdn.jsdelivr.net/npm/tailwindcss@2.2.19/dist/tailwind.min.css" rel="stylesheet">
    <link rel="stylesheet" href="src/style.css">
</head>
<body class="bg-gray-100 text-gray-800 flex items-center justify-center h-screen"></body>

<div class="text-center">
    <h1 class="text-9xl font-bold mb-4">404</h1>
    <p class="text-2xl mb-4">Oops! The page you're looking for doesn't exist.</p>
    <a href="index.jsp" class="text-lg text-blue-500 hover:underline">Go back to Home</a>
</div>

</body>
</html>
